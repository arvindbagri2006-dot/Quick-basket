# Public Firebase web app configuration. These values identify the project and are not service-account secrets.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-project-number

# Optional restricted browser key for Google Maps.
# VITE_GOOGLE_MAPS_API_KEY=restricted-browser-key

# Optional cinematic intro duration in milliseconds (clamped to 3000–4000).
VITE_INTRO_DURATION_MS=3500

# The local prototype uses the trusted Node/SQLite API by default in Vite development.
# For a self-hosted production build with this API, set VITE_API_MODE=server and
# route /api/* to server.js. Firebase Hosting static hosting alone does not run Node.
# VITE_API_MODE=server

# The Firebase-only client path intentionally refuses order creation and staff
# provisioning until a trusted Cloud Function/backend has been deployed.
# Trusted Node API deployment settings (configure in the server host, not VITE_ vars).
# PORT=5174
# QB_ALLOWED_ORIGIN=https://your-hostname.example
# QB_DB_PATH=/var/lib/quick-basket/quick-basket.sqlite

# Optional backend fulfilment settings (server environment only; never VITE_ secrets).
QB_DELIVERY_TIME_ZONE=Asia/Kolkata
QB_INSTANT_MIN_MINUTES=30
QB_INSTANT_MAX_MINUTES=60
QB_SAME_DAY_MIN_HOURS=2
QB_SAME_DAY_MAX_HOURS=4
QB_PICKUP_HOURS=12
QB_INSTANT_FEE=35
QB_SAME_DAY_FEE=25
QB_FREE_DELIVERY_OVER=499

# Initial accounts for a fresh local demo database only.
# QB_ADMIN_EMAIL=admin@example.com
# QB_ADMIN_PASSWORD=use-a-strong-password
# QB_VISHESH_PASSWORD=use-a-temporary-password
# QB_NAMIT_PASSWORD=use-a-temporary-password

# Existing demo database account reset utility (run only when intentionally resetting demo credentials).
# QB_PRESENTATION_ADMIN_PASSWORD=...
# QB_PRESENTATION_SHOP_PASSWORD=...
# QB_PRESENTATION_DELIVERY_PASSWORD=...
